NODE_ENV=development
PORT=4000
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Exact browser origins, comma separated. Native apps do not send an Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Leave 0 locally. Set 1 only behind Railway's single trusted ingress.
TRUST_PROXY_HOPS=0
# Static codes are restricted to non-production deployments and an explicit phone allowlist.
GAMEON_TEST_LOGIN_ENABLED=false
GAMEON_TEST_PHONES=
GAMEON_AUTH_SECRET=
GAMEON_TEST_USER_CODE=
GAMEON_TEST_ADMIN_CODE=

# Optional: Expo push access token when enhanced push security is enabled.
EXPO_ACCESS_TOKEN=
